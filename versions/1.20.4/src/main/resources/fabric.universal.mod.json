      "game-versions": [
        "1.19.1",
        "1.19.2",
        "1.20",
        "1.20.1",
        "1.20.2",
        "1.20.3",
        "1.20.4",
        "1.20.5",
        "1.20.6"
      ],
      "dependencies": {
        "fabric-api": {
          "type": "required"
        },
        "geckolib": {
          "type": "required"
        },
        "owo-lib": {
          "type": "required"
        },
        "satin": {
          "type": "required"
        }
      }
    }
  }
