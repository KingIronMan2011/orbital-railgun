  "authors": [
    "KingIronMan2011"
  ],
  "contributors": [
    "Mishkis",
    "HyIsNoob"
  ],
  "contact": {
    "issues": "https://github.com/KingIronMan2011/orbital-railgun-enhanced/issues",
    "sources": "https://github.com/KingIronMan2011/orbital-railgun-enhanced"
  },
  "license": "MIT",
  "icon": "assets/orbital_railgun_enhanced/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "io.github.kingironman2011.orbital_railgun_enhanced.universal.UniversalClientInitializer"
    ],
    "main": [
      "io.github.kingironman2011.orbital_railgun_enhanced.universal.UniversalModInitializer"
    ],
    "owo": [
      "io.github.kingironman2011.orbital_railgun_enhanced.impl.v1_20_4.client.config.EnhancedConfig"
    ]
  },
  "mixins": [
