      "config": "orbital_railgun_enhanced.client.mixins.v1_19_2.json",
      "environment": "client"
    },
    {
      "config": "orbital_railgun_enhanced.client.mixins.v1_20_4.json",
      "environment": "client"
    },
    {
      "config": "orbital_railgun_enhanced.client.mixins.v1_20_6.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
